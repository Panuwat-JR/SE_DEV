# PostgreSQL ในเครื่องเท่านั้น — รัน ./start.sh หรือจาก root: docker compose up -d
# (user / password / database: nuseed — พอร์ตโฮสต์ 55432)
DATABASE_URL=postgresql://nuseed:nuseed@127.0.0.1:55432/nuseed
PORT=5000

# ชื่อ firstname เริ่มต้นเมื่อไม่มี header X-Participant-Firstname (พอร์ทัลผู้เข้าร่วม)
DEMO_PARTICIPANT_FIRSTNAME=ปิยะ

# Frontend dev: ตั้ง VITE_DEV_API_PROXY=http://localhost:<PORT_ตรงกับค่าด้านบน> — ดู frontend/.env.example

# อีเมลเพิ่มเติมที่ให้ล็อกอินเป็นผู้บริหาร (คั่นด้วยจุลภาค) — ทางเลือกนอกเหนือคอลัมน์ employees.portal_access
# EXECUTIVE_EMAILS=

# dev เท่านั้น: ผ่อนรหัสผ่านผู้เข้าร่วมถ้าไม่มี hash (ไม่ใช้บน production)
# NU_SEED_RELAX_PARTICIPANT_AUTH=0
