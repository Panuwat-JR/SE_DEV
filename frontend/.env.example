# พอร์ต backend ต้องตรงกับ PORT ใน backend/.env (ค่าเริ่มต้น 5000)
VITE_DEV_API_PROXY=http://localhost:5000

# Production build เท่านั้น: origin ของ API (ไม่มี trailing slash)
# ในโหมด `npm run dev` ค่านี้ถูกละเว้น — ใช้ proxy แทน
# VITE_API_BASE=https://api.example.com

# ให้ dev เรียก VITE_API_BASE (หรือ localhost:5000) โดยตรง แทน proxy — ใช้เมื่อจำเป็นจริง ๆ
# VITE_USE_FULL_API_IN_DEV=true

# ชื่อ firstname เดโมในฟอร์มล็อกอินผู้เข้าร่วม — ควรตรงกับ DEMO_PARTICIPANT_FIRSTNAME ใน backend/.env
# VITE_DEMO_PARTICIPANT_FIRSTNAME=ปิยะ
